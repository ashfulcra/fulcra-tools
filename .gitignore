.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.superpowers/
# .claude/ is a local working directory (transcripts, caches, per-machine
# settings) and stays ignored — EXCEPT the two files that must travel with the
# repo so a fresh container can bootstrap itself without a human: the
# SessionStart hook and the settings that register it. A negation cannot reach
# inside an ignored DIRECTORY, so this is `.claude/*` rather than `.claude/`.
# settings.local.json stays ignored deliberately: it is the per-machine
# permission-grant file and must never be shared between boxes.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json

# AI / planning working artifacts — kept locally, never committed.
# These are the brainstorm specs, subagent execution plans, and
# session resume/QA scratch the team uses while building, not part of
# the product. Product + human docs (docs/TESTING.md,
# docs/how-do-i-get-my-data.md) stay tracked.
/SESSION_HANDOFF.md
/CREDS_NEEDED.md
/docs/E2E_STATUS.md
/docs/plans/
/docs/superpowers/
packages/*/docs/superpowers/

# Briefcase / app-bundle build artifacts (regenerated by scripts/build_macos_app.sh)
/wheelhouse/
packages/menubar/build/
packages/menubar/dist/
packages/menubar/logs/
.primitives-state/
/.worktrees/

# Third-party agent skills installed by `npx skills@latest add ...` (tool-managed,
# like node_modules — the installer writes both paths and re-creates them on demand).
# Deliberately NOT vendored: these run with full agent permissions, this repo is the
# substrate every coordination agent clones, and `git add -A` in the docs-QA flow
# would otherwise sweep them into an unrelated commit.
/.agents/
/skills-lock.json
